{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bachkator.dev/schemas/approval-provider-v1.schema.json",
  "title": "Bach Approval Provider v1",
  "type": "object",
  "$defs": {
    "Capability": {
      "type": "string",
      "enum": ["poll"]
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "HandshakeParams": {
      "type": "object",
      "required": ["protocol", "factory", "approval"],
      "properties": {
        "protocol": { "const": "bach.approval.v1" },
        "factory": { "type": "string", "minLength": 1 },
        "approval": { "type": "string", "minLength": 1 },
        "config": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "HandshakeResult": {
      "type": "object",
      "required": ["protocol", "provider", "version", "capabilities"],
      "properties": {
        "protocol": { "const": "bach.approval.v1" },
        "provider": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Capability" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "PollParams": {
      "type": "object",
      "properties": {
        "config": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "PollResult": {
      "type": "object",
      "required": ["approvals"],
      "properties": {
        "approvals": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalRecord" }
        }
      },
      "additionalProperties": false
    },
    "ApprovalRecord": {
      "type": "object",
      "required": ["phase"],
      "anyOf": [
        { "required": ["work_item_id"] },
        { "required": ["source_type", "source_id"] }
      ],
      "properties": {
        "work_item_id": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "approver": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
